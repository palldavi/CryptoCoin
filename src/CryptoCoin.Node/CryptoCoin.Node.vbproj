  <!-- Copy SQLite native interop DLLs to output directory -->
  <Target Name="CopySQLiteInterop" AfterTargets="Build">
    <PropertyGroup>
      <_SQLiteLib>..\..\lib\SQLite</_SQLiteLib>
    </PropertyGroup>
    <Copy SourceFiles="$(_SQLiteLib)\x64\SQLite.Interop.dll" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(_SQLiteLib)\x64\SQLite.Interop.dll" DestinationFolder="$(OutputPath)x64\" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(_SQLiteLib)\x86\SQLite.Interop.dll" DestinationFolder="$(OutputPath)x86\" SkipUnchangedFiles="true" />
  </Target>
